diff --git a/core/modules/views/js/ajax_view.js b/core/modules/views/js/ajax_view.js
index 1fbb7d1282de..664ca9ad1a3e 100644
--- a/core/modules/views/js/ajax_view.js
+++ b/core/modules/views/js/ajax_view.js
@@ -85,13 +85,28 @@
       // Remove the question mark and Drupal path component if any.
       queryString = queryString.slice(1);
 
+      // Collect the base names of every named field in the exposed form. The
+      // trailing `[…]` is stripped so a multi-select field named `type[]`
+      // matches URL params serialized by PHP as `type[0]`, `type[1]`, or
+      // `type[]`.
+      const stripArraySuffix = (name) => {
+        const bracketIndex = name.indexOf('[');
+        return bracketIndex === -1 ? name : name.slice(0, bracketIndex);
+      };
+      const exposedFieldBaseNames = new Set();
+      this.$exposed_form
+        .find('input[name], select[name], textarea[name]')
+        .each(function () {
+          exposedFieldBaseNames.add(stripArraySuffix(this.name));
+        });
+
       // Remove current exposed filters.
       const params = decodeURI(queryString)
         .split('&')
         .filter((param) => {
-          const [name, value] = param.split('=');
+          const [name] = param.split('=');
           return (
-            this.$exposed_form.find(`input[name="${name}"]`).length === 0 &&
+            !exposedFieldBaseNames.has(stripArraySuffix(name)) &&
             /*
             Submitting filters should reset paging and sorting
             because that is what happens without AJAX.
diff --git a/core/modules/views/tests/src/FunctionalJavascript/ExposedFilterAJAXTest.php b/core/modules/views/tests/src/FunctionalJavascript/ExposedFilterAJAXTest.php
index 5e465d33150f..680927b42280 100644
--- a/core/modules/views/tests/src/FunctionalJavascript/ExposedFilterAJAXTest.php
+++ b/core/modules/views/tests/src/FunctionalJavascript/ExposedFilterAJAXTest.php
@@ -252,6 +252,63 @@ public function testExposedFilteringWithButtonElement(): void {
     $this->assertSame($ajax_views_before, $ajax_views_after);
   }
 
+  /**
+   * Tests deselecting a multi-select exposed filter clears it from the URL.
+   */
+  public function testUnselectMultiSelectExposedFilter(): void {
+    // Flip the type filter to allow multiple selections.
+    \Drupal::configFactory()->getEditable('views.view.content')
+      ->set('display.default.display_options.filters.type.expose.multiple', TRUE)
+      ->save();
+
+    // Create a second content type and a node of that type so we can tell the
+    // filter was actually cleared.
+    $this->createContentType(['type' => 'article']);
+    $this->createNode(['type' => 'article', 'title' => 'Article One']);
+
+    $assert = $this->assertSession();
+    $page = $this->getSession()->getPage();
+
+    $this->drupalGet('admin/content', ['query' => ['type[]' => 'page']]);
+    $html = $page->getHtml();
+    $this->assertStringContainsString('Page One', $html);
+    $this->assertStringNotContainsString('Article One', $html);
+
+    $select = $page->find('css', 'select[name="type[]"]');
+    $this->assertNotNull($select);
+    $select->setValue([]);
+    $page->pressButton('Filter');
+    $assert->assertWaitOnAjaxRequest();
+
+    $html = $page->getHtml();
+    $this->assertStringContainsString('Page One', $html);
+    $this->assertStringContainsString('Article One', $html);
+    $url = $this->getSession()->getCurrentUrl();
+    $this->assertStringNotContainsString('type%5B%5D=page', $url);
+    $this->assertStringNotContainsString('type[]=page', $url);
+
+    $this->drupalGet('admin/content', [
+      'query' => ['type[0]' => 'article', 'type[1]' => 'page'],
+    ]);
+    $html = $page->getHtml();
+    $this->assertStringContainsString('Page One', $html);
+    $this->assertStringContainsString('Article One', $html);
+
+    $select = $page->find('css', 'select[name="type[]"]');
+    $this->assertNotNull($select);
+    // Keep only article selected; drop page.
+    $select->setValue(['article']);
+    $page->pressButton('Filter');
+    $assert->assertWaitOnAjaxRequest();
+
+    $html = $page->getHtml();
+    $this->assertStringContainsString('Article One', $html);
+    $this->assertStringNotContainsString('Page One', $html);
+    $this->assertStringNotContainsString('Page Two', $html);
+    $url = $this->getSession()->getCurrentUrl();
+    $this->assertStringNotContainsString('=page', $url);
+  }
+
   /**
    * Tests that errors messages are displayed for exposed filters via ajax.
    */
-- 
