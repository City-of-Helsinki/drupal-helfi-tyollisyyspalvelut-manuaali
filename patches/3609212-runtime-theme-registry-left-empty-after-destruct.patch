From bf9235e4469becc98974c68583a488f45cf393f1 Mon Sep 17 00:00:00 2001
From: Eduardo Morales <eduardo.morales@metadrop.net>
Date: Wed, 8 Jul 2026 10:01:45 +0200
Subject: [PATCH 1/2] fix: #3609212 Runtime ThemeRegistry left empty after
 destruct(), causing "Theme hook not found" warnings

---
 core/lib/Drupal/Core/Theme/Registry.php | 5 +++++
 1 file changed, 5 insertions(+)

diff --git a/core/lib/Drupal/Core/Theme/Registry.php b/core/lib/Drupal/Core/Theme/Registry.php
index 3bbfb425bcb1..fffefbaa81e9 100644
--- a/core/lib/Drupal/Core/Theme/Registry.php
+++ b/core/lib/Drupal/Core/Theme/Registry.php
@@ -956,6 +956,11 @@ public function destruct() {
     foreach ($this->runtimeRegistry as $runtime_registry) {
       $runtime_registry->destruct();
     }
+    // CacheCollector::destruct() calls reset() on each runtime registry,
+    // emptying its storage. Drop the now-empty instances so a subsequent
+    // getRuntime() call rebuilds a complete registry instead of reusing an
+    // emptied one.
+    $this->runtimeRegistry = [];
   }
 
   /**
