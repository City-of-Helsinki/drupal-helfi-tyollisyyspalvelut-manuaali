From ebfd79a57ed2cfdc0450976f83f8e4f956a20f1e Mon Sep 17 00:00:00 2001
From: genebobmiller <genebobmiller@gmail.com>
Date: Fri, 19 Sep 2025 11:27:02 +1000
Subject: [PATCH 4/5] Issue #2906455: Only use 'latest-version' link template
 if route is accessible

---
 .../Plugin/Field/FieldFormatter/StringFormatter.php  | 12 ++++++++++--
 1 file changed, 10 insertions(+), 2 deletions(-)

diff --git a/core/lib/Drupal/Core/Field/Plugin/Field/FieldFormatter/StringFormatter.php b/core/lib/Drupal/Core/Field/Plugin/Field/FieldFormatter/StringFormatter.php
index 898f95fec930..f1adb1ce35c5 100644
--- a/core/lib/Drupal/Core/Field/Plugin/Field/FieldFormatter/StringFormatter.php
+++ b/core/lib/Drupal/Core/Field/Plugin/Field/FieldFormatter/StringFormatter.php
@@ -189,8 +189,16 @@ protected function getEntityUrl(EntityInterface $entity) {
 
     // If this is not the default revision and is the latest translation
     // affected revision, then show a URL pointing to the latest version.
-    if ($rel == 'revision' && !$entity->isDefaultRevision() && $entity->isLatestTranslationAffectedRevision() && $entity->hasLinkTemplate('latest-version')) {
-      $rel = 'latest-version';
+    if ($rel === 'revision'
+      && !$entity->isDefaultRevision()
+      && $entity->isLatestTranslationAffectedRevision()
+      && $entity->hasLinkTemplate('latest-version')) {
+
+      $url = $entity->toUrl('latest-version');
+      if ($url->access()) {
+        $rel = 'latest-version';
+      }
+      // else keep $rel as 'revision' so consumers that expect revision links aren't broken.
     }
 
     return $entity->toUrl($rel);
-- 
