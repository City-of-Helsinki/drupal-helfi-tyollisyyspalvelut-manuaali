        "drupal/coder": "*",
        "drupal/content_lock": "^3.0@RC",
        "drupal/context": "^5",
        "drupal/core-composer-scaffold": "^11.4@RC",
        "drupal/core-recommended": "^11.4@RC",
        "drupal/csv_serialization": "^4.0",
        "drupal/date_recur": "^3.8",
        "drupal/date_recur_modular": "^3.2",
        "drupal/dependent_fields": "^1.0",
        "drupal/diff": "^1",
        "drupal/disable_html5_validation": "^2.0",
        "drupal/dropzonejs": "^2.8",
        "drupal/editor_advanced_link": "^2.1",
        "drupal/emulsify": "^6.1",
        "drupal/emulsify_twig": "^5.0",
        "drupal/entity_browser": "^2.9",
