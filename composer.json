        "drupal/entitygroupfield": "^2.0@RC",
        "drupal/epp": "^1.3",
        "drupal/eu_cookie_compliance": "^1.24",
        "drupal/eva": "^3.1",
        "drupal/facets": "^3.0",
        "drupal/field_group": "^4.0",
        "drupal/field_permissions": "^1.1",
        "drupal/file_download_link": "^2.0",
        "drupal/filter_empty_tags": "^2.1",
        "drupal/flag": "^4.0@beta",
        "drupal/flag_lists": "^4.0",
        "drupal/flexible_permissions": "^2",
        "drupal/gcontent_moderation": "^2.0@beta",
        "drupal/gdpr": "3.1.2",
        "drupal/geoblock": "^1.0",
        "drupal/geoblock_maxmind": "^1.0",
        "drupal/ggroup": "^2.0@RC",
        "drupal/ginvite": "^3.0",
        "drupal/group": "^2.3",
        "drupal/group_roles_management": "^2",
        "drupal/health_check": "^3.0",
        "drupal/hook_post_action": "^2",
        "drupal/ief_popup": "^2",
        "drupal/ief_table_view_mode": "^3",
        "drupal/inline_entity_form": "^3",
        "drupal/jquery_ui_datepicker": "^2.1",
        "drupal/jquery_ui_slider": "^2.1",
        "drupal/jquery_ui_tooltip": "^2.1",
        "drupal/jquery_ui_touch_punch": "^1.1",
        "drupal/linkchecker": "^2.0",
        "drupal/log_stdout": "^3",
        "drupal/mail_login": "^4.2",
        "drupal/markup": "^2",
        "drupal/maxlength": "^3",
        "drupal/menu_breadcrumb": "^2.0",
        "drupal/menu_item_fields": "^1.5",
        "drupal/menu_item_role_access": "*",
        "drupal/message": "^1.6",
        "drupal/message_notify": "^1.2",
        "drupal/message_ui": "*",
        "drupal/migrate_plus": "^6.0",
        "drupal/migrate_source_csv": "^3.5",
        "drupal/migrate_tools": "^6.0",
        "drupal/node_edit_protection": "^1.0",
        "drupal/nodeaccess": "^2.0@alpha",
        "drupal/notification_message": "^2.0@RC",
        "drupal/paragraphs": "^1.12",
        "drupal/paragraphs_asymmetric_translation_widgets": "^1.4",
        "drupal/password_policy": "^4.0",
        "drupal/pathauto": "^1.8",
        "drupal/purge": "*",
        "drupal/radioactivity": "^4.1",
        "drupal/range": "^1.3",
        "drupal/real_aes": "^2.5",
        "drupal/recently_read": "^1.5",
        "drupal/redirect": "^1.7",
        "drupal/redis": "^1.7",
        "drupal/remove_http_headers": "^2",
        "drupal/require_on_publish": "^2.0",
        "drupal/rules": "^4.0",
        "drupal/search_api": "^1.23",
        "drupal/search_api_autocomplete": "^1.11",
        "drupal/search_api_solr": "^4.3",
        "drupal/search_api_sorts": "^1.1",
        "drupal/seckit": "^2.0",
        "drupal/select2": "^2",
        "drupal/selective_better_exposed_filters": "*",
        "drupal/simplei": "^3",
        "drupal/smtp": "^1.2",
        "drupal/stable": "^2",
        "drupal/svg_image": "^3.2",
        "drupal/symfony_mailer": "^1.6",
        "drupal/themable_forms": "^1.1",
        "drupal/tmgmt": "^1.17",
        "drupal/toc_js": "^3.3",
        "drupal/token": "^1.10",
        "drupal/token_views_filter": "^2.1",
        "drupal/twig_tweak": "^3.2",
        "drupal/upgrade_status": "^4.0",
        "drupal/varnish_purge": "*",
        "drupal/view_password": "^6.0",
        "drupal/views_ajax_history": "^1.8",
        "drupal/views_bulk_edit": "^3.0",
        "drupal/views_bulk_operations": "^4.4",
        "drupal/views_contextual_filters_or": "^1.4",
        "drupal/views_data_export": "^1.3",
        "drupal/views_field_view": "^1.0",
        "drupal/views_infinite_scroll": "^2.0",
        "drupal/views_load_more": "^2.0",
        "drupal/views_negate": "^2.0",
        "drush/drush": "^13",
        "enyo/dropzone": "^5.7",
        "npm-asset/select2": "^4.0",
        "oomphinc/composer-installers-extender": "^2.0",
        "platformsh/config-reader": "^2.4",
        "twbs/bootstrap": "^5",
        "twbs/bootstrap-dist": "^5",
        "vlucas/phpdotenv": "^5.1",
        "webflo/drupal-finder": "^1.2",
        "weitzman/logintrait": "^1.2"
    },
    "require-dev": {
        "brainmaestro/composer-git-hooks": "*",
        "drupal/core-dev": "^11",
        "drupal/twig_xdebug": "^1.4",
        "phpspec/prophecy-phpunit": "^2.0",
        "vincentlanglet/twig-cs-fixer": "*",
        "weitzman/drupal-test-traits": "^2.2",
        "zaporylie/composer-drupal-optimizations": "^1.2"
    },
    "conflict": {
        "drupal/drupal": "*"
    },
    "minimum-stability": "dev",
    "prefer-stable": true,
    "replace": {
        "drupal/ctools": "*"
    },
    "config": {
        "platform": {
            "php": "8.3"
        },
        "audit": {
            "abandoned": "ignore"
        },
        "discard-changes": true,
        "sort-packages": true,
        "process-timeout":0,
        "allow-plugins": {
            "composer/installers": true,
            "cweagans/composer-patches": true,
            "dealerdirect/phpcodesniffer-composer-installer": true,
            "drupal/console-extend-plugin": true,
            "drupal/core-composer-scaffold": true,
            "oomphinc/composer-installers-extender": true,
            "php-http/discovery": true,
            "phpstan/extension-installer": true,
            "symfony/runtime": true,
            "tbachert/spi": true,
            "zaporylie/composer-drupal-optimizations": true
        }
    },
    "autoload": {
        "classmap": [
            "scripts/composer/ScriptHandler.php"
        ],
        "files": ["load.environment.php"],
        "psr-4": {
            "Drupal\\Tests\\dtt\\": "tests/dtt/src"
        }
    },
    "scripts": {
        "pre-install-cmd": [
            "DrupalProject\\composer\\ScriptHandler::checkComposerVersion"
        ],
        "pre-update-cmd": [
            "DrupalProject\\composer\\ScriptHandler::checkComposerVersion"
        ],
        "post-install-cmd": [
            "DrupalProject\\composer\\ScriptHandler::createRequiredFiles"
        ],
        "post-update-cmd": [
            "DrupalProject\\composer\\ScriptHandler::createRequiredFiles"
        ]
    },
    "extra": {
        "drupal-scaffold": {
            "locations": {
                "web-root": "public/"
            }
        },
        "hooks": {
            "pre-commit": [
                "scripts/git/pre-commit/custom-module-lint-check",
                "scripts/git/pre-commit/custom-theme-lint-check"
            ],
            "config": {
                "stop-on-failure": [
                    "pre-commit"
                ]
            }
        },
        "installer-paths": {
            "public/core": ["type:drupal-core"],
            "public/libraries/{$name}": [
                "type:drupal-library",
                "vendor:npm-asset",
                "vendor:bower-asset"
            ],
            "public/modules/contrib/{$name}": ["type:drupal-module"],
            "public/profiles/contrib/{$name}": ["type:drupal-profile"],
            "public/themes/contrib/{$name}": ["type:drupal-theme"],
            "drush/Commands/contrib/{$name}": ["type:drupal-drush"]
        },
        "installer-types": ["bower-asset", "npm-asset"],
        "composer-exit-on-patch-failure": true,
        "patchLevel": {
            "drupal/core": "-p2"
        },
        "patches": {
            "drupal/core": {
                "https://www.drupal.org/project/drupal/issues/3135409#comment-14746356": "https://www.drupal.org/files/issues/2022-10-17/3135409-17.patch",
                "https://www.drupal.org/project/drupal/issues/3338260#comment-14900238": "https://www.drupal.org/files/issues/2023-02-01/skip_changing_affected_flag_3338260-2.patch",
                "Unable to change non-translatable field value on translatable content with content moderation enabled (https://www.drupal.org/project/drupal/issues/2955321)": "https://www.drupal.org/files/issues/2024-04-16/2955321-77.patch",
                "Inconsistent database because of a bug in the Content Moderation module (https://www.drupal.org/project/drupal/issues/3088790#comment-15837881)": "https://www.drupal.org/files/issues/2024-10-30/content-moderation-unpublished-translation-3088790-37.patch",
                "DateTimeComputed tries to compute from an empty value (https://www.drupal.org/project/drupal/issues/3052608#comment-16004608)": "https://www.drupal.org/files/issues/2025-02-26/3052608.patch",
                "Concurrent ajax submits cause user data loss (https://www.drupal.org/project/drupal/issues/2830295#comment-15685036)": "https://www.drupal.org/files/issues/2024-07-16/2830295-71.patch",
                "Ajax exposed filters not working for multiple instances (https://www.drupal.org/i/3163299#comment-15829959)": "https://www.drupal.org/files/issues/2024-10-24/3163299_120_d10.3.5.patch",
                "Cannot save or publish originating node or translations. error \"The content has either been modified by another user, or you have already submitted modifications \"(https://www.drupal.org/project/drupal/issues/3285657)": "https://www.drupal.org/files/issues/2022-06-14/core9.2-node-lock-translations-2744851.patch",
                "Link to latest revision (https://www.drupal.org/i/2906455#comment-15996236)": "https://www.drupal.org/files/issues/2026-06-23/2906455-59.patch"
            },
            "drupal/better_exposed_filters": {
                "Fix undefined array key #default_value": "patches/bef-default-value.patch"
            },
            "drupal/message": {
                "https://www.drupal.org/files/issues/2018-06-24/allow_token_contexts-3.patch": "https://www.drupal.org/files/issues/2018-06-24/allow_token_contexts-3.patch"
            },
            "drupal/elasticsearch_connector": {
                "https://www.drupal.org/project/elasticsearch_connector/issues/2912308#comment-14000645": "https://www.drupal.org/files/issues/2021-02-16/partial-search-issue-2912308-14.patch",
                "patches/elasticsearch_snakeoil_cert.patch": "patches/elasticsearch_snakeoil_cert.patch",
                "https://www.drupal.org/project/elasticsearch_connector/issues/3092486": "https://www.drupal.org/files/issues/2019-11-05/3092486.patch"
            },
            "drupal/group": {
                "https://www.drupal.org/project/group/issues/2942657#comment-15285989": "https://www.drupal.org/files/issues/2023-10-23/2942657-31.patch"
