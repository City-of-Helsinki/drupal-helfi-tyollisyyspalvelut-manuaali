        "drupal/admin_toolbar": "^3.0",
        "drupal/ajax_dependency": "^2.0",
        "drupal/autologout": "^1.4",
        "drupal/better_exposed_filters": "^7.1",
        "drupal/block_breakpoint": "^1.0@alpha",
