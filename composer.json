            },
            "drupal/conditional_fields": {
                "https://www.drupal.org/project/conditional_fields/issues/3467267#comment-16024811": "https://www.drupal.org/files/issues/2025-03-12/conditional_fields-co-dependent-fields-save-error-3467267-7.patch"
            },
            "drupal/linkchecker": {
                "Fix broken link list when field_permission module is installed": "patches/link-checker-field-permission-fix.patch"
            },
            "drupal/date_recur": {
                "Temporary fix for field deletion": "patches/date-recurr-field-delete.patch"
            },
            "drupal/token_views_filter": {
                "WSOD when filtering by Date field (https://www.drupal.org/project/token_views_filter/issues/3499480#comment-16167091)": "https://www.drupal.org/files/issues/2025-06-26/token_view_filer-wsod-when-filtering-by-date-field_3499480-7.patch"
            },
            "drupal/content_lock": {
                "content_lock_entity_operation doesn't work if the entity list is cached (https://www.drupal.org/project/content_lock/issues/2919019#comment-16635990)": "https://www.drupal.org/files/issues/2026-06-16/content-locked-entity-operation-doesnt-work-3.x-2919019-26.patch"
            },
            "drupal/tmgmt": {
                "Computed fields and not translatable fields from paragraphs are being translated (https://www.drupal.org/project/tmgmt/issues/3382356#comment-16104653)": "https://www.drupal.org/files/issues/2025-05-12/3382356_field_translation_checks_ordered_by_granularity.patch",
                "Wrong field order when fields are in field groups (https://www.drupal.org/project/tmgmt/issues/3586466)": "https://www.drupal.org/files/issues/2026-05-18/reweight-grouped-fields-3586466-4.patch",
                "Fields Content Deletions of (already Translated) Entity Content are not reflected in new Translations updates (https://www.drupal.org/project/tmgmt/issues/3278370#comment-16475359)": "https://www.drupal.org/files/issues/2026-02-18/tmgmt-content-fields-deletions-3278370-19.patch"
            },
            "drupal/svg_image": {
                "Fix $fileUrlGenerator Fatal error (https://www.drupal.org/project/svg_image/issues/3592477#comment-16600469)": "https://www.drupal.org/files/issues/2026-05-28/svg_image_fix_formatter_3592477.patch"
            },
            "drupal/eva": {
                "Unchecked link_display setting causes error (https://www.drupal.org/project/eva/issues/3606104#comment-16657947)": "https://www.drupal.org/files/issues/2026-06-25/3606104-unchecked-link-display-causes-error-3.patch"
            }
        }
    }
}
