                "https://www.drupal.org/project/ggroup/issues/3395476": "patches/ggroup-role-mapper-support-3395476.patch",
                "Usage of \\PDO::FETCH_* constants is deprecated (https://www.drupal.org/project/ggroup/issues/3559518#comment-16357666)": "patches/3559518-ggroup-pdo-fetch-error-d11.patch"
