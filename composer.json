            },
            "drupal/entity_export_csv": {
                "https://www.drupal.org/project/entity_export_csv/issues/3166121": "https://www.drupal.org/files/issues/2025-05-14/3166121-allow-to-use-entity-export-csv-config-17.patch"
            },
            "drupal/entity_reference_revisions": {
                "https://www.drupal.org/project/entity_reference_revisions/issues/3150084#comment-15398765": "https://www.drupal.org/files/issues/2024-01-15/3150084-35.patch"
            },
            "drupal/diff": {
                "Revision form list show wrong moderation state (https://www.drupal.org/project/diff/issues/3322352#comment-15910500)": "https://www.drupal.org/files/issues/2024-12-20/revision_overview_form_3322352.patch",
