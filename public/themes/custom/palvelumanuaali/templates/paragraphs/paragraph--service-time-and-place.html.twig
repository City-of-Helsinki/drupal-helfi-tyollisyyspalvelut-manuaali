{#
/**
 * @file
 * Default theme implementation to display a paragraph.
 *
 * Available variables:
 * - paragraph: Full paragraph entity.
 *   - id: The paragraph ID.
 *   - bundle: The type of the paragraph, for example, "image" or "text".
 *   - authorid: The user ID of the paragraph author.
 *   - createdtime: Formatted creation date. Preprocess functions can
 *     reformat it by calling format_date() with the desired parameters on
 *     $variables['paragraph']->getCreatedTime().
 * - content: All paragraph items. Use {{ content }} to print them all,
 *   or print a subset such as {{ content.field_example }}. Use
 *   {{ content|without('field_example') }} to temporarily suppress the printing
 *   of a given child element.
 * - attributes: HTML attributes for the containing element.
 *   The attributes.class element may contain one or more of the following
 *   classes:
 *   - paragraphs: The current template type (also known as a "theming hook").
 *   - paragraphs--type-[type]: The current paragraphs type. For example, if the paragraph is an
 *     "Image" it would result in "paragraphs--type--image". Note that the machine
 *     name will often be in a short form of the human readable label.
 *   - paragraphs--view-mode--[view_mode]: The View Mode of the paragraph; for example, a
 *     preview would result in: "paragraphs--view-mode--preview", and
 *     default: "paragraphs--view-mode--default".
 * - view_mode: View mode; for example, "preview" or "full".
 * - logged_in: Flag for authenticated user status. Will be true when the
 *   current user is a logged-in member.
 * - is_admin: Flag for admin user status. Will be true when the current user
 *   is an administrator.
 *
 * @see template_preprocess_paragraph()
 *
 * @ingroup themeable
 */
#}

{%
  set classes = [
    paragraph.bundle|clean_class
  ]
%}
{% set date_fields = [
    'field_date_selection',
    'field_start_and_end_date',
    'field_date',
    'field_multiple_dates',
    'field_separate_time',
    'field_weekday_and_time'
  ]
%}
{% set channel = paragraph.field_service_channel.value %}
{% set date_selection = paragraph.field_date_selection.value %}
{% set show_time = date_selection and date_selection != 'service_no_time' %}
{# Only the field matching the selected service channel is displayed. #}
{% set channel_fields = {
    'location': 'field_service_location',
    'online_service': 'field_online_service_link',
    'telephone_service': 'field_phone_service_number',
  }
%}
{% set channel_field = channel_fields[channel] ?? null %}
{% set handled_fields = date_fields|merge([
    'field_service_location',
    'field_online_service_link',
    'field_phone_service_number',
    'field_location_additional_info_1',
    'field_time_additional_info_html',
  ])
%}
<div{{ attributes.addClass(classes) }}>
  {% if channel_field %}
    {{ attribute(content, channel_field) }}
  {% else %}
    {# Legacy paragraphs without a channel: keep the previous behavior. #}
    {{ content.field_service_location }}
    {{ content.field_online_service_link }}
    {{ content.field_phone_service_number }}
  {% endif %}
  {{ content.field_location_additional_info_1 }}
  {{ content|without(handled_fields) }}
  {% if show_time %}
    <div class='date-wrapper o--five d--flex'>
      {% include "@atoms/images/icons/_icon.twig" with {
      icon_base_class: 'icon',
      icon_name: 'calendar-dark-blue',
      icon_modifiers: ['small'],
      } %}
      <div class='text-wrapper'>
        <div class='field__label'>{{ "Time"|t({}, {'context' : 'Weekday and time display'}) }}</div>
        {% for field in date_fields %}
          {{ attribute(content, field) }}
        {% endfor %}
      </div>
    </div>
    {{ content.field_time_additional_info_html }}
  {% endif %}
</div>
