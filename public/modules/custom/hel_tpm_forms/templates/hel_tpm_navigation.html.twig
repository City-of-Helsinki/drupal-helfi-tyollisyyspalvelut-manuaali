{#
/**
 * @file
 * Theme override to display a block.
 *
 * Available variables:
 * - content: The content of this block.
 * - start_page: Whether the first step has a button back to the start page.
 *
 * @see template_preprocess_block()
 */
#}

<div class='nav page-controls'>
  <div class='button-wrapper'>
    {% if start_page %}
      <button class='button btn-prev btn-start-page' type="button" hidden>
        {% include "@atoms/images/icons/_icon.twig" with {
          icon_base_class: 'icon',
          icon_name: 'arrow-left',
          icon_modifiers: ['small'],
        } %}
        {{ 'Previous'|t }}
      </button>
    {% endif %}
    <button class='button btn-prev' type="button" id="prevBtn">
      {% include "@atoms/images/icons/_icon.twig" with {
        icon_base_class: 'icon',
        icon_name: 'arrow-left',
        icon_modifiers: ['small'],
      } %}
      {{'Previous'|t}}
    </button>
    <button class='button btn-next' type="button" id="nextBtn">
      <span id="nextBtnText" class='text-wrapper'>{{'Next'|t}}</span>
      {% include "@atoms/images/icons/_icon.twig" with {
        icon_base_class: 'icon',
        icon_name: 'arrow-right',
        icon_modifiers: ['small'],
      } %}
    </button>
  </div>
</div>
