{#
/**
 * @file
 * Theme override to display a block.
 *
 * Available variables:
 * - content: The content of this block.
 *
 * @see template_preprocess_block()
 */ #}

{% set step_count = steps|length %}

<nav class='node-service-edit-form-pager node-form prevent-scroll'>
  <ol class='stepper multistep-nav-wrapper'>
  {% for step in steps %}
    <li class="multistep-nav-item{{ not step.accessible ? ' is-disabled' }}">
      <button type="button" id="step-{{ loop.index}}" class="step nav-step-{{ loop.index - 1 }} multistep-nav" aria-current="false" aria-label="{{ step.label }} {{ loop.index }}/{{ step_count }}"  data-step="{{ loop.index -1 }}"
              {% if step.html_id %} aria-controls="{{ step.html_id }}"{% endif %}
              {% if not step.accessible %} aria-disabled="true" aria-describedby="multistep-nav-disabled-desc"{% endif %}>
        <span class="step__number nav-icon">{{ loop.index }}</span>
        <span class="step__label label">{{ step.label }}</span>
      </button>
    </li>
  {% endfor %}
  </ol>
  <p id="multistep-nav-disabled-desc" class="visually-hidden">
    {{ 'You do not have access to this step.'|t }}
  </p>
</nav>
